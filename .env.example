# MySQL Configuration
MYSQL_DATABASE=livestream
MYSQL_USER=livestream
MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# JWT Security
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_LONG_SECRET_KEY_FOR_HS256

# Initial Admin Account
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
APP_ADMIN_EMAIL=admin@example.com

# Public URLs
APP_PUBLIC_URL=http://localhost:3000
MEDIAMTX_RTMP_PUBLIC_URL=rtmp://localhost:1935/live
MEDIAMTX_HLS_PUBLIC_URL=/hls/live

# Internal Service URLs
MEDIAMTX_API_URL=http://mediamtx:9997
REDIS_HOST=redis
REDIS_PORT=6379

# Spring Profile
SPRING_PROFILES_ACTIVE=prod
